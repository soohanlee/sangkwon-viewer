# ─────────────────────────────────────────────────────────────
# 상권분석 수집기 API 키 설정
# 이 파일을 복사해서 .env 로 만들고 발급받은 키를 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 로 커밋에서 제외됩니다.
# ─────────────────────────────────────────────────────────────

# [공공데이터포털] 소상공인시장진흥공단 상가(상권)정보 - 15012005 / 15083033
# data.go.kr 마이페이지 > 일반 인증키(Decoding) 값을 그대로 넣으세요.
DATA_GO_KR_SERVICE_KEY=

# [통계청 SGIS] 오픈API - 인구/가구/소득
# sgis.kostat.go.kr 에서 발급받은 서비스 ID(consumer_key) / 보안 Key(consumer_secret)
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# [국토교통부 실거래가] 상업업무용 부동산 매매/전월세 - data.go.kr (1613000)
# 공공데이터포털 동일 키를 쓸 수 있으면 비워두면 DATA_GO_KR_SERVICE_KEY 를 재사용합니다.
MOLIT_SERVICE_KEY=

# [소상공인365 / 소상공인 상권정보시스템] 상권분석
# 별도 발급 키가 있으면 입력. (개방형 API 형태 확인 필요)
SBIZ365_SERVICE_KEY=

# [서울 열린데이터광장] 골목상권 분석서비스 - 유동인구/추정매출/점포/폐업률
# data.seoul.go.kr 에서 발급. 비우면 'sample' 키로 동작(최대 5건 제한, 테스트용)
SEOUL_OPEN_API_KEY=
